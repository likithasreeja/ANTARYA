# Google Analytics 4 Measurement ID
# Create a GA4 property → Data Streams → Web Stream → Measurement ID (G-XXXXXXXXXX)
# Leave blank or set your real Measurement ID:
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API Backend URL (Optional in dev, Vite proxy automatically forwards /api to port 5001)
# VITE_API_URL=http://localhost:5001/api
